# Minimal page for record-marker tests: every tt_content element of colPos 0, rendered by the tt_content object that
# AQG's own setup.typoscript wraps with record markers for valid scanner requests.
tt_content = COA
tt_content.10 = TEXT
tt_content.10.field = header
tt_content.10.wrap = <p>|</p>

page = PAGE
page.10 = CONTENT
page.10.table = tt_content
page.10.select.orderBy = sorting
page.10.select.where = {#colPos}=0
