{
    "name": "priebera/typo3-a11y-quality-gate",
    "description": "TYPO3 accessibility checker and quality gate with CKEditor feedback, WCAG issue management, rendered page checks and editor workflows.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "homepage": "https://typo3.priebera.sk/products/accessibility-quality-gate",
    "keywords": [
        "typo3",
        "typo3-extension",
        "typo3-accessibility",
        "accessibility",
        "accessibility-checker",
        "wcag",
        "a11y",
        "ckeditor",
        "quality-gate",
        "editor-workflow",
        "accessibility-audit",
        "bfsg",
        "bitv",
        "eaa"
    ],
    "authors": [
        {
            "name": "Patrik Priebera",
            "email": "patrik@priebera.sk",
            "role": "Developer",
            "homepage": "https://www.priebera.sk/"
        }
    ],
    "support": {
        "issues": "https://github.com/priebera1/typo3-a11y-quality-gate/issues",
        "source": "https://github.com/priebera1/typo3-a11y-quality-gate",
        "docs": "https://typo3.priebera.sk/docs",
        "email": "support@priebera.sk"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-backend": "^13.4 || ^14.3",
        "typo3/cms-frontend": "^13.4 || ^14.3",
        "typo3/cms-rte-ckeditor": "^13.4 || ^14.3",
        "typo3/cms-scheduler": "^13.4 || ^14.3",
        "mpdf/mpdf": "^8.2"
    },
    "suggest": {
        "ext-sodium": "Required when saving encrypted HTTP authentication passwords for remote scan access."
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "typo3/testing-framework": "^9.4",
        "dg/bypass-finals": "^1.8",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Priebera\\A11yQualityGate\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Priebera\\A11yQualityGate\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "a11y_quality_gate",
            "Package": {
                "providesPackages": {}
            },
            "version": "1.7.0"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        }
    }
}
